{
  "name": "x-autopilot-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "X (Twitter) 智能运营 Chrome 插件 — Manifest V3 + Vite + React + Tailwind",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --skip-vite",
    "dev": "node scripts/build.mjs && vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.24.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
